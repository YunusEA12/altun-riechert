# Sicherheits-Einstellungen für den IONOS-Webserver (Apache). Greift nur, wenn diese Datei mit hochgeladen wird.

# Keine Ordnerlisten anzeigen
Options -Indexes

# Versteckte Dateien (.htaccess, .git, .env …) nie ausliefern
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

# HTTPS erzwingen und HSTS erst einschalten, wenn das SSL-Zertifikat der Domain sicher aktiv ist:
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
# Header always set Strict-Transport-Security "max-age=31536000"
